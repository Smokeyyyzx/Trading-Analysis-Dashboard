    '<div class="text-sm font-semibold text-cyan-400">SCREENSHOT-ANALYSE</div>' +
    '<div class="grid grid-cols-2 gap-2 text-sm">' +
    '<div><span class="text-slate-400">Datei:</span> ' + filename + '</div>' +
    '<div><span class="text-slate-400">Analyse-Qualität:</span> <span class="text-yellow-400">🟡 20 %</span></div>' +
    '<div><span class="text-slate-400">Asset:</span> nicht automatisch erkannt</div>' +
    '<div><span class="text-slate-400">Zeitrahmen:</span> nicht erkannt</div></div>' +
    '<div class="text-xs text-slate-400 space-y-1 border-t border-slate-700 pt-2">' +
    '<p>• In dieser Browser-Version kann die App Candlesticks und Preise aus dem Bild <strong>nicht</strong> auslesen.</p>' +
    '<p>• Dafür bräuchte es ein Vision-Modell (serverseitig).</p>' +
    '<p>• Du kannst den Screenshot manuell mit dem Live-Chart vergleichen.</p>' +
    '<p>• Es werden <strong>keine</strong> Kurse oder Signale aus dem Bild erfunden.</p></div>' +
    '<div class="pt-2 border-t border-slate-700"><div class="text-lg font-bold text-yellow-400">🟡 ABWARTEN</div>' +
    '<p class="text-sm text-slate-300 mt-1">Nicht genügend maschinenlesbare Daten im Screenshot für ein Setup.</p></div>' +
    '<p class="text-xs text-slate-500">Screenshot ≠ Live-Analyse · Zeitpunkt unbekannt</p></div>';
}

function initTfButtons() {
  document.querySelectorAll('.tf-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.tf-btn').forEach(function(b) {
        b.classList.remove('bg-cyan-700');
        b.classList.add('bg-slate-800');
      });
      btn.classList.add('bg-cyan-700');
      btn.classList.remove('bg-slate-800');
      state.currentTf = btn.dataset.tf;
      loadTradingViewChart(state.symbol, state.currentTf);
    });
  });
}

function init() {
  document.querySelectorAll('.mode-btn').forEach(function(b) {
    b.addEventListener('click', function() { setMode(b.dataset.mode); });
  });
  document.getElementById('market-select').addEventListener('change', function(e) {
    changeMarket(e.target.value);
  });
  loadHistory();
  const resetBtn = document.getElementById('stat-reset');
  if (resetBtn) resetBtn.addEventListener('click', function() {
    if (confirm('Treffer-Statistik und Signal-Historie wirklich löschen?')) { state.signalHistory = []; persistHistory(); renderHistory(); renderStats(); }
  });
  setInterval(evaluatePendingSignals, 30000);
  initTfButtons();
  initSourceControls();
  initScreenshot();
  renderWatchlist();
  if (!restoreSaved()) changeMarket('BINANCE:BTCUSDT');
  setInterval(function() { if (!state.symbol.startsWith('BINANCE:')) updatePrice(); }, 5000);
  setInterval(function() { fetchNews(state.newsQuery); }, 180000);
  startWatchlistStream();
  setInterval(updateDataAge, 1000);
}

window.addEventListener('error', function(e) {
  const el = document.getElementById('ai-explanation');
  if (el && String(e.message).indexOf('tailwind') < 0 && e.message !== 'Script error.') el.textContent = 'Programmfehler: ' + e.message + ' (Zeile ' + e.lineno + ')';
});
document.addEventListener('DOMContentLoaded', init);

</script>
</body>
</html>
