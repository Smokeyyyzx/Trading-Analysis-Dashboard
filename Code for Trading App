async function fetchNews(query) {
  state.newsQuery = query;
  try {
    const q = encodeURIComponent(query || 'crypto OR stock market');
    const url = 'https://news.google.com/rss/search?q=' + q + '&hl=de&gl=DE&ceid=DE:de';
    const proxy = 'https://api.allorigins.win/get?url=' + encodeURIComponent(url);
    const res = await fetch(proxy, { cache: 'no-store' });
    if (!res.ok) throw new Error('proxy fail');
    const wrapped = await res.json();
    const parser = new DOMParser();
    const xml = parser.parseFromString(wrapped.contents, 'text/xml');
    const items = Array.from(xml.querySelectorAll('item')).slice(0, 6);
    state.news = items.map(function(item) {
      return {
        title: (item.querySelector('title') && item.querySelector('title').textContent) || '—',
        link: (item.querySelector('link') && item.querySelector('link').textContent) || '#',
        pubDate: (item.querySelector('pubDate') && item.querySelector('pubDate').textContent) || '',
        source: 'Google News'
      };
    });
    document.getElementById('dq-news').innerHTML = '<span class="status-live">RSS aktiv</span>';
  } catch (e) {
    state.news = [{ title: 'News-Feed gerade nicht erreichbar', link: '#', pubDate: '', source: 'System' }];
    document.getElementById('dq-news').innerHTML = '<span class="status-offline">nicht verfügbar</span>';
