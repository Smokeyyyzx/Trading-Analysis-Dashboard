<!DOCTYPE html>
<html lang="de" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DayTrade Analyzer — Professionelle Marktanalyse</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            surface: { 50: '#f8fafc', 100: '#f1f5f9', 200: '#e2e8f0', 800: '#1e293b', 900: '#0f172a', 950: '#020617' },
            accent: { DEFAULT: '#22d3ee', muted: '#0891b2' },
            long: '#22c55e', short: '#ef4444', wait: '#eab308'
          }
        }
      }
    }
  </script>
  <script src="https://unpkg.com/lightweight-charts@4.2.0/dist/lightweight-charts.standalone.production.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <style>
    :root { color-scheme: dark; }
    body { background: #020617; color: #e2e8f0; font-family: 'Inter', system-ui, sans-serif; }
    .card { background: #0f172a; border: 1px solid #1e293b; border-radius: 12px; }
    .signal-long { background: linear-gradient(135deg, #052e16 0%, #14532d 100%); border-color: #22c55e; }
    .signal-short { background: linear-gradient(135deg, #450a0a 0%, #7f1d1d 100%); border-color: #ef4444; }
    .signal-wait { background: linear-gradient(135deg, #422006 0%, #713f12 100%); border-color: #eab308; }
    .status-live { color: #22c55e; }
    .status-delayed { color: #eab308; }
    .status-offline { color: #ef4444; }
    .scrollbar-thin::-webkit-scrollbar { width: 6px; height: 6px; }
    .scrollbar-thin::-webkit-scrollbar-track { background: #0f172a; }
    .scrollbar-thin::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
    .tv-chart { min-height: 420px; }
    .drop-zone { border: 2px dashed #334155; transition: all 0.2s; }
    .drop-zone.dragover { border-color: #22d3ee; background: rgba(34, 211, 238, 0.05); }
    .tooltip { position: relative; }
    .tooltip:hover .tooltip-text { visibility: visible; opacity: 1; }
    .tooltip-text { visibility: hidden; opacity: 0; position: absolute; z-index: 50; bottom: 125%; left: 50%; transform: translateX(-50%); background: #1e293b; color: #e2e8f0; padding: 6px 10px; border-radius: 6px; font-size: 12px; white-space: nowrap; transition: opacity 0.2s; }
    @keyframes pulse-soft { 0%, 100% { opacity: 1; } 50% { opacity: 0.6; } }
    .pulse { animation: pulse-soft 2s infinite; }
  </style>
</head>
<body class="min-h-screen">
  <!-- Header -->
  <header class="sticky top-0 z-40 border-b border-slate-800 bg-slate-950/95 backdrop-blur">
    <div class="max-w-[1800px] mx-auto px-4 py-3 flex flex-wrap items-center gap-4 justify-between">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-cyan-500/20 flex items-center justify-center">
          <i class="fas fa-chart-line text-cyan-400"></i>
        </div>
        <div>
          <h1 class="text-lg font-semibold tracking-tight">DayTrade Analyzer</h1>
          <p class="text-xs text-slate-400">3M/5M Daytrade-Fokus · Analyse — keine Gewinn-Garantie</p>
        </div>
      </div>
      <div class="flex items-center gap-3 flex-wrap">
        <div id="connection-status" class="flex items-center gap-2 text-sm px-3 py-1.5 rounded-full bg-slate-900 border border-slate-700">
          <span class="w-2 h-2 rounded-full bg-green-500 pulse"></span>
          <span class="status-live font-medium">LIVE</span>
        </div>
        <div class="text-xs text-slate-400">
          <span>Update: </span><span id="last-update">—</span>
          <span class="mx-1">·</span>
          <span>Alter: </span><span id="data-age">—</span>
        </div>
        <select id="market-select" class="bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 max-w-[220px]">
          <optgroup label="── Krypto ──">
            <option value="BINANCE:BTCUSDT">BTC/USDT</option>
            <option value="BINANCE:ETHUSDT">ETH/USDT</option>
            <option value="BINANCE:SOLUSDT">SOL/USDT</option>
            <option value="BINANCE:XRPUSDT">XRP/USDT</option>
            <option value="BINANCE:DOGEUSDT">DOGE/USDT</option>
            <option value="BINANCE:ADAUSDT">ADA/USDT</option>
            <option value="BINANCE:AVAXUSDT">AVAX/USDT</option>
            <option value="BINANCE:LINKUSDT">LINK/USDT</option>
            <option value="BINANCE:DOTUSDT">DOT/USDT</option>
            <option value="BINANCE:BNBUSDT">BNB/USDT</option>
            <option value="BINANCE:NEARUSDT">NEAR/USDT</option>
            <option value="BINANCE:SUIUSDT">SUI/USDT</option>
            <option value="BINANCE:APTUSDT">APT/USDT</option>
            <option value="BINANCE:ARBUSDT">ARB/USDT</option>
            <option value="BINANCE:OPUSDT">OP/USDT</option>
            <option value="BINANCE:PEPEUSDT">PEPE/USDT</option>
            <option value="BINANCE:WIFUSDT">WIF/USDT</option>
            <option value="BINANCE:INJUSDT">INJ/USDT</option>
            <option value="BINANCE:TIAUSDT">TIA/USDT</option>
            <option value="BINANCE:SEIUSDT">SEI/USDT</option>
            <option value="BINANCE:FETUSDT">FET/USDT (AI)</option>
            <option value="BINANCE:RENDERUSDT">RENDER/USDT (AI)</option>
            <option value="BINANCE:TAOUSDT">TAO/USDT (AI)</option>
          </optgroup>
          <optgroup label="── AI & Chips (Aktien) ──">
            <option value="NASDAQ:NVDA">NVIDIA (NVDA)</option>
            <option value="NASDAQ:AMD">AMD</option>
            <option value="NASDAQ:AVGO">Broadcom (AVGO)</option>
            <option value="NASDAQ:TSM">TSMC (TSM)</option>
            <option value="NASDAQ:ASML">ASML</option>
            <option value="NASDAQ:INTC">Intel (INTC)</option>
            <option value="NASDAQ:QCOM">Qualcomm (QCOM)</option>
            <option value="NASDAQ:MU">Micron (MU)</option>
            <option value="NASDAQ:ARM">ARM</option>
            <option value="NASDAQ:SMCI">Super Micro (SMCI)</option>
          </optgroup>
          <optgroup label="── Tech & Big Tech ──">
            <option value="NASDAQ:AAPL">Apple (AAPL)</option>
            <option value="NASDAQ:MSFT">Microsoft (MSFT)</option>
            <option value="NASDAQ:GOOGL">Alphabet (GOOGL)</option>
            <option value="NASDAQ:AMZN">Amazon (AMZN)</option>
            <option value="NASDAQ:META">Meta (META)</option>
            <option value="NASDAQ:TSLA">Tesla (TSLA)</option>
            <option value="NASDAQ:DELL">Dell (DELL)</option>
            <option value="NASDAQ:ORCL">Oracle (ORCL)</option>
            <option value="NASDAQ:CRM">Salesforce (CRM)</option>
            <option value="NASDAQ:PLTR">Palantir (PLTR)</option>
          </optgroup>
          <optgroup label="── Indizes & ETF ──">
            <option value="AMEX:SPY">S&P 500 (SPY)</option>
            <option value="AMEX:QQQ">NASDAQ-100 (QQQ)</option>
            <option value="AMEX:IWM">Russell 2000 (IWM)</option>
            <option value="AMEX:SOXX">Semiconductor ETF (SOXX)</option>
            <option value="AMEX:SMH">VanEck Semi (SMH)</option>
          </optgroup>
          <optgroup label="── Forex & Rohstoffe ──">
            <option value="FX:EURUSD">EUR/USD</option>
            <option value="FX:GBPUSD">GBP/USD</option>
            <option value="TVC:GOLD">Gold</option>
            <option value="TVC:USOIL">Öl (WTI)</option>
          </optgroup>
        </select>
        <div class="flex gap-1">
          <button data-mode="live" class="mode-btn px-3 py-1.5 rounded-lg text-sm font-medium bg-cyan-600 text-white">LIVE</button>
          <button data-mode="screenshot" class="mode-btn px-3 py-1.5 rounded-lg text-sm font-medium bg-slate-800 text-slate-300 hover:bg-slate-700">Screenshot</button>
          <button data-mode="hybrid" class="mode-btn px-3 py-1.5 rounded-lg text-sm font-medium bg-slate-800 text-slate-300 hover:bg-slate-700">Hybrid</button>
        </div>
      </div>
    </div>
  </header>

  <!-- Disclaimer Banner -->
  <div class="bg-amber-950/40 border-b border-amber-800/50 px-4 py-2 text-center text-xs text-amber-200/90">
    <i class="fas fa-exclamation-triangle mr-1"></i>
    Marktdaten und Signale können fehlerhaft, verzögert oder unvollständig sein. Keine Analyse kann zukünftige Kursbewegungen garantieren. Dies ist ein Analysewerkzeug — kein automatischer Handel.
  </div>

  <main class="max-w-[1800px] mx-auto p-4 grid grid-cols-1 xl:grid-cols-12 gap-4">
    <!-- Left: Chart + Multi-TF -->
    <section class="xl:col-span-8 space-y-4">
      <!-- Price Header -->
      <div class="card p-4 flex flex-wrap items-center justify-between gap-4">
        <div>
          <div class="flex items-baseline gap-3">
            <h2 id="symbol-name" class="text-2xl font-bold">BTC/USDT</h2>
            <span id="price-display" class="text-3xl font-mono font-semibold text-cyan-400">—</span>
            <span id="change-display" class="text-lg font-medium">—</span>
          </div>
          <div class="flex gap-4 mt-1 text-xs text-slate-400">
            <span>Quelle: <span id="data-source">TradingView / Binance Public</span></span>
            <span id="data-status-badge" class="status-live">🟢 LIVE</span>
          </div>
        </div>
        <div class="flex gap-2 text-sm">
          <div class="px-3 py-1 rounded-lg bg-slate-800">
            <span class="text-slate-400">Regime:</span>
            <span id="market-regime" class="font-medium ml-1">—</span>
          </div>
          <div class="px-3 py-1 rounded-lg bg-slate-800">
            <span class="text-slate-400">Volatilität:</span>
            <span id="volatility-level" class="font-medium ml-1">—</span>
          </div>
        </div>
      </div>

      <!-- TradingView Chart -->
      <div class="card p-2">
        <div class="flex items-center justify-between px-2 py-1 mb-1">
          <span class="text-sm font-medium text-slate-300">Live-Chart</span>
          <div class="flex gap-2 text-xs">
            <button class="tf-btn px-2 py-1 rounded bg-slate-800 hover:bg-slate-700" data-tf="3">3M</button>
            <button class="tf-btn px-2 py-1 rounded bg-cyan-700" data-tf="5">5M</button>
            <button class="tf-btn px-2 py-1 rounded bg-slate-800 hover:bg-slate-700" data-tf="15">15M</button>
            <button class="tf-btn px-2 py-1 rounded bg-slate-800 hover:bg-slate-700" data-tf="60">1H</button>
            <button class="tf-btn px-2 py-1 rounded bg-slate-800 hover:bg-slate-700" data-tf="240">4H</button>
          </div>
        </div>
        <div id="tv-chart-container" class="tv-chart w-full rounded-lg overflow-hidden" style="height: 480px;"></div>
        <div class="px-2 py-1 text-xs text-slate-500 flex justify-between">
          <span>Candlesticks · Volumen · EMA · Unterstützt von TradingView Widget</span>
          <span id="chart-data-note">Datenstatus wird vom Widget bereitgestellt</span>
        </div>
      </div>

      <!-- Multi-Timeframe Panel -->
      <div class="card p-4">
        <h3 class="text-sm font-semibold mb-3 flex items-center gap-2">
          <i class="fas fa-layer-group text-cyan-400"></i> Multi-Timeframe Analyse
        </h3>
        <div class="overflow-x-auto scrollbar-thin">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-slate-400 border-b border-slate-800">
                <th class="text-left py-2 pr-4">Zeitrahmen</th>
                <th class="text-left py-2 pr-4">Trend</th>
                <th class="text-left py-2 pr-4">Momentum</th>
                <th class="text-left py-2 pr-4">RSI</th>
                <th class="text-left py-2 pr-4">MACD</th>
                <th class="text-left py-2 pr-4">EMA-Struktur</th>
                <th class="text-left py-2 pr-4">Volumen</th>
                <th class="text-left py-2">Struktur</th>
              </tr>
            </thead>
            <tbody id="mtf-tbody">
              <tr class="border-b border-slate-800/50">
                <td class="py-2.5 font-medium">3 Minuten</td>
                <td id="tf3-trend">—</td>
                <td id="tf3-mom">—</td>
                <td id="tf3-rsi">—</td>
                <td id="tf3-macd">—</td>
                <td id="tf3-ema">—</td>
                <td id="tf3-vol">—</td>
                <td id="tf3-struct">—</td>
              </tr>
              <tr class="border-b border-slate-800/50">
                <td class="py-2.5 font-medium">5 Minuten</td>
                <td id="tf5-trend">—</td>
                <td id="tf5-mom">—</td>
                <td id="tf5-rsi">—</td>
                <td id="tf5-macd">—</td>
                <td id="tf5-ema">—</td>
                <td id="tf5-vol">—</td>
                <td id="tf5-struct">—</td>
              </tr>
              <tr>
                <td class="py-2.5 font-medium">1 Stunde</td>
                <td id="tf1h-trend">—</td>
                <td id="tf1h-mom">—</td>
                <td id="tf1h-rsi">—</td>
                <td id="tf1h-macd">—</td>
                <td id="tf1h-ema">—</td>
                <td id="tf1h-vol">—</td>
                <td id="tf1h-struct">—</td>
              </tr>
            </tbody>
          </table>
        </div>
        <div id="mtf-summary" class="mt-3 p-3 rounded-lg bg-slate-900/80 text-sm text-slate-300">
          Multi-Timeframe-Zusammenfassung wird berechnet …
        </div>
      </div>

      <!-- Screenshot Mode Panel (hidden by default) -->
      <div id="screenshot-panel" class="card p-6 hidden">
        <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
          <i class="fas fa-camera text-cyan-400"></i> Chart analysieren (Screenshot)
        </h3>
        <div id="drop-zone" class="drop-zone rounded-xl p-10 text-center cursor-pointer">
          <i class="fas fa-cloud-upload-alt text-4xl text-slate-500 mb-3"></i>
          <p class="text-slate-300 mb-1">Screenshot hierher ziehen oder Datei auswählen</p>
          <p class="text-xs text-slate-500 mb-4">PNG, JPG, JPEG, WEBP — TradingView, Binance, Broker-Charts etc.</p>
          <input type="file" id="screenshot-input" accept="image/png,image/jpeg,image/jpg,image/webp" class="hidden" />
          <button id="select-file-btn" class="px-4 py-2 bg-cyan-600 hover:bg-cyan-500 rounded-lg text-sm font-medium">Datei auswählen</button>
        </div>
        <div id="screenshot-preview" class="mt-4 hidden">
          <img id="preview-img" class="max-h-64 mx-auto rounded-lg border border-slate-700" alt="Screenshot Preview" />
          <div id="screenshot-status" class="mt-3 text-center text-sm text-slate-400">Chart wird analysiert …</div>
        </div>
        <div id="screenshot-result" class="mt-4 hidden space-y-3"></div>
        <p class="mt-4 text-xs text-slate-500">
          Die KI erkennt nur, was im Bild sichtbar ist. Nicht erkennbare Elemente werden als „nicht verfügbar“ markiert. 
          Screenshot-Analyse ist keine Live-Analyse.
        </p>
      </div>
    </section>

    <!-- Right: Signal, Risk, News, Watchlist -->
    <aside class="xl:col-span-4 space-y-4">
      <!-- Trading Signal Card — klar & prominent -->
      <div id="signal-card" class="card p-5 signal-wait border-2">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Empfehlung jetzt</h3>
          <span id="signal-strength" class="text-xs px-2 py-0.5 rounded bg-slate-800">—/100</span>
        </div>
        <div id="signal-main" class="text-3xl font-bold mb-1 tracking-tight">
          🟡 ABWARTEN
        </div>
        <p id="signal-action" class="text-sm text-slate-300 mb-4">Warte auf klare Richtung …</p>

        <div class="grid grid-cols-2 gap-2 text-sm mb-4">
          <div class="bg-slate-950/50 rounded-lg p-2">
            <div class="text-xs text-slate-500">Trend</div>
            <div id="sig-trend" class="font-medium">—</div>
          </div>
          <div class="bg-slate-950/50 rounded-lg p-2">
            <div class="text-xs text-slate-500">Risiko</div>
            <div id="sig-risk" class="font-medium">—</div>
          </div>
          <div class="bg-slate-950/50 rounded-lg p-2">
            <div class="text-xs text-slate-500">Chance/Risiko</div>
            <div id="sig-rr" class="font-medium">—</div>
          </div>
          <div class="bg-slate-950/50 rounded-lg p-2">
            <div class="text-xs text-slate-500">Konfidenz</div>
            <div id="sig-conf" class="font-medium">—</div>
          </div>
        </div>

        <!-- Konkrete Levels – immer sichtbar -->
        <div class="border border-slate-700 rounded-xl p-3 mb-4 bg-slate-950/40">
          <div class="text-xs font-semibold text-cyan-400 mb-2 uppercase tracking-wider">Konkrete Levels</div>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between items-center">
              <span class="text-slate-400">Entry-Zone</span>
              <span id="entry-zone" class="font-mono font-semibold text-cyan-300">—</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-slate-400">Stop-Loss setzen bei</span>
              <span id="stop-loss" class="font-mono font-bold text-red-400 text-base">—</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-slate-400">Take-Profit 1</span>
              <span id="tp1" class="font-mono font-semibold text-green-400">—</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-slate-400">Take-Profit 2</span>
              <span id="tp2" class="font-mono font-semibold text-green-400">—</span>
            </div>
            <div class="flex justify-between items-center pt-2 border-t border-slate-700">
              <span class="text-slate-400">Chance : Risiko</span>
              <span id="rr-ratio" class="font-bold text-white">—</span>
            </div>
          </div>
          <p class="mt-2 text-[11px] text-slate-500">Dynamisch aus ATR + Struktur. Keine Garantie. Immer selbst prüfen.</p>
        </div>

        <div class="border-t border-slate-700 pt-3">
          <p class="text-xs text-slate-400 mb-2 font-medium">Warum diese Empfehlung?</p>
          <ul id="signal-reasons" class="text-sm space-y-1.5 text-slate-300">
            <li class="text-slate-500">Warte auf ausreichende Daten …</li>
          </ul>
        </div>
        <div class="mt-3 p-3 rounded-lg bg-slate-950/60 text-xs text-slate-400 leading-relaxed" id="ai-explanation">
          Die Erklärung erscheint, sobald genug aktuelle Daten da sind.
        </div>
      </div>

      <!-- Positions-Management: Raus / Shorten / Halten -->
      <div class="card p-4 border border-amber-800/40">
        <h3 class="text-sm font-semibold mb-3 flex items-center gap-2">
          <i class="fas fa-door-open text-amber-400"></i> Positions-Management
        </h3>
        <p class="text-[11px] text-slate-500 mb-3">Falls du schon im Trade bist — oder ob du jetzt shorten solltest:</p>
        <div class="space-y-3 text-sm">
          <div class="rounded-lg bg-slate-950/60 p-3 border border-slate-700">
            <div class="text-xs font-semibold text-green-400 mb-1">Wenn du LONG bist</div>
            <div id="mgmt-long" class="text-slate-300 leading-snug">—</div>
          </div>
          <div class="rounded-lg bg-slate-950/60 p-3 border border-slate-700">
            <div class="text-xs font-semibold text-red-400 mb-1">Wenn du SHORT bist / Shorten?</div>
            <div id="mgmt-short" class="text-slate-300 leading-snug">—</div>
          </div>
          <div class="rounded-lg bg-slate-950/60 p-3 border border-slate-700">
            <div class="text-xs font-semibold text-cyan-400 mb-1">Zeitfenster / bis wann</div>
            <div id="mgmt-until" class="text-slate-300 leading-snug">—</div>
          </div>
        </div>
      </div>

      <!-- Risk Card -->
      <div class="card p-4">
        <h3 class="text-sm font-semibold mb-3 flex items-center gap-2">
          <i class="fas fa-shield-alt text-amber-400"></i> Risiko-Management
        </h3>
        <div id="risk-level" class="text-xl font-bold mb-2">🟡 MITTEL</div>
        <ul id="risk-reasons" class="text-sm space-y-1 text-slate-300">
          <li>— Daten werden geladen</li>
        </ul>
      </div>

      <!-- News -->
      <div class="card p-4">
        <h3 class="text-sm font-semibold mb-3 flex items-center gap-2">
          <i class="fas fa-newspaper text-cyan-400"></i> Relevante Nachrichten
        </h3>
        <div id="news-list" class="space-y-3 max-h-64 overflow-y-auto scrollbar-thin text-sm">
          <p class="text-slate-500 text-xs">Lade aktuelle Nachrichten …</p>
        </div>
        <p class="mt-2 text-xs text-slate-500">Korrelation ≠ Kausalität. Nachrichten werden zeitlich mit Kursbewegungen verglichen.</p>
      </div>

      <!-- Watchlist -->
      <div class="card p-4">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-sm font-semibold flex items-center gap-2">
            <i class="fas fa-list text-cyan-400"></i> Watchlist
          </h3>
          <button id="add-watch-btn" class="text-xs text-cyan-400 hover:text-cyan-300">+ Hinzufügen</button>
        </div>
        <div id="watchlist" class="space-y-1.5 text-sm">
          <!-- filled by JS -->
        </div>
      </div>

      <!-- Treffer-Statistik -->
      <div class="card p-4 border border-cyan-800/40">
        <h3 class="text-sm font-semibold mb-3 flex items-center gap-2">
          <i class="fas fa-chart-pie text-cyan-400"></i> Treffer-Statistik (echt gemessen)
        </h3>
        <div class="grid grid-cols-3 gap-2 text-center mb-3">
          <div class="bg-slate-950/60 rounded-lg p-2">
            <div class="text-xs text-slate-500">Gesamt</div>
            <div id="stat-total" class="text-lg font-bold">0</div>
          </div>
          <div class="bg-slate-950/60 rounded-lg p-2">
