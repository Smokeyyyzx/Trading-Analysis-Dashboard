function calcSetup(type, noStructure, scalp) {
  noStructure = noStructure || !!scalp;
  const t5 = state.mtf['5'] || {};
  const isWait = !type || type === 'WAIT';
  const dir = isWait ? (state._levelBias || 'LONG') : type;
  if (!t5.lastClose || !t5.atr) {
    document.getElementById('entry-zone').textContent = '—';
    document.getElementById('stop-loss').textContent = '—';
    document.getElementById('tp1').textContent = '—';
    document.getElementById('tp2').textContent = '—';
    document.getElementById('rr-ratio').textContent = '—';
    document.getElementById('sig-rr').textContent = '—';
    state.setup = { entry: null, sl: null, tp1: null, tp2: null, rr: null };
    return;
  }
  const price = t5.lastClose;
  const atr = scalp ? (((state.mtf['3'] || {}).atr) || t5.atr) * 0.92 : t5.atr;
  let entryLow, entryHigh, sl, tp1, tp2, rr;

  // Prefer structure-based levels when available
  const support = noStructure ? null : (t5.sr && t5.sr.support);
  const resistance = noStructure ? null : (t5.sr && t5.sr.resistance);
  const fib = noStructure ? null : t5.fib;

  if (dir === 'LONG') {
    // Entry near current price or slight pullback
    entryLow = price - atr * 0.2;
    entryHigh = price + atr * 0.08;
    // SL below support or 1.3 ATR
    if (support && support < price && (price - support) / price < 0.025) {
      sl = support - atr * 0.15;
    } else {
      sl = price - atr * 1.3;
    }
    // TP at resistance or ATR multiples
    if (resistance && resistance > price) {
      tp1 = price + (resistance - price) * 0.6;
      tp2 = resistance;
    } else {
      tp1 = price + atr * 1.8;
      tp2 = price + atr * 3.0;
    }
    // Fib extension preference
    if (fib && fib.direction === 'up' && fib.high > price) {
      tp2 = Math.max(tp2, fib.high);
    }
    const risk = Math.max(entryHigh - sl, price * 1e-6);
    const reward = tp1 - entryHigh;
    rr = (reward / risk).toFixed(1);
  } else {
    entryLow = price - atr * 0.08;
    entryHigh = price + atr * 0.2;
    if (resistance && resistance > price && (resistance - price) / price < 0.025) {
      sl = resistance + atr * 0.15;
    } else {
      sl = price + atr * 1.3;
    }
    if (support && support < price) {
      tp1 = price - (price - support) * 0.6;
      tp2 = support;
    } else {
      tp1 = price - atr * 1.8;
      tp2 = price - atr * 3.0;
    }
    if (fib && fib.direction === 'down' && fib.low < price) {
      tp2 = Math.min(tp2, fib.low);
    }
    const risk = Math.max(sl - entryLow, price * 1e-6);
    const reward = entryLow - tp1;
    rr = (reward / risk).toFixed(1);
  }

  if (isWait) {
    document.getElementById('entry-zone').textContent = formatPrice(entryLow) + ' – ' + formatPrice(entryHigh) + ' (' + dir + '-Orientierung)';
    document.getElementById('stop-loss').textContent = formatPrice(sl);
    document.getElementById('tp1').textContent = formatPrice(tp1);
    document.getElementById('tp2').textContent = formatPrice(tp2);
    document.getElementById('rr-ratio').textContent = '1 : ' + rr + ' (Orientierung, kein Signal)';
    document.getElementById('sig-rr').textContent = '1 : ' + rr;
    state.setup = { entry: [entryLow, entryHigh], sl: sl, tp1: tp1, tp2: tp2, rr: rr, orient: true };
    return;
  }
  if (parseFloat(rr) < 1.2 && !noStructure) { calcSetup(type, true, scalp); return; }
  if (parseFloat(rr) < 1.2) {
    document.getElementById('entry-zone').textContent = '—';
    document.getElementById('stop-loss').textContent = '—';
    document.getElementById('tp1').textContent = '—';
    document.getElementById('tp2').textContent = '—';
    document.getElementById('rr-ratio').textContent = 'zu schlecht (<1.2)';
    document.getElementById('sig-rr').textContent = 'schlecht';
    if (state.signal.type !== 'WAIT') {
      setSignal('WAIT', 20, state.signal.reasons.concat(['⚠️ Chance/Risiko unter 1:1.2 — kein Setup']),
        'Chance-Risiko-Verhältnis ist zu schlecht. Kein Trade.');
    }
    return;
  }

  document.getElementById('entry-zone').textContent = formatPrice(entryLow) + ' – ' + formatPrice(entryHigh);
  document.getElementById('stop-loss').textContent = formatPrice(sl);
  document.getElementById('tp1').textContent = formatPrice(tp1);
  document.getElementById('tp2').textContent = formatPrice(tp2);
  document.getElementById('rr-ratio').textContent = '1 : ' + rr + (scalp ? ' (Scalp, 3M-ATR)' : noStructure ? ' (ATR-Ziele)' : '');
  document.getElementById('sig-rr').textContent = '1 : ' + rr + (scalp ? ' (Scalp, 3M-ATR)' : noStructure ? ' (ATR-Ziele)' : '');
  state.setup = { entry: [entryLow, entryHigh], sl: sl, tp1: tp1, tp2: tp2, rr: rr };
}

