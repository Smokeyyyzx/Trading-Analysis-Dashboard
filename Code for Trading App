function calcEMA(closes, period) {
  if (!closes || closes.length < period) return null;
  const k = 2 / (period + 1);
  let ema = closes.slice(0, period).reduce(function(a, b) { return a + b; }, 0) / period;
  for (let i = period; i < closes.length; i++) ema = closes[i] * k + ema * (1 - k);
  return ema;
}

function calcRSI(closes, period) {
  period = period || 14;
  if (!closes || closes.length < period + 1) return null;
  let g = 0, l = 0;
  for (let i = 1; i <= period; i++) { const d = closes[i] - closes[i - 1]; if (d >= 0) g += d; else l -= d; }
  let ag = g / period, al = l / period;
  for (let i = period + 1; i < closes.length; i++) {
    const d = closes[i] - closes[i - 1];
    ag = (ag * (period - 1) + Math.max(d, 0)) / period;
    al = (al * (period - 1) + Math.max(-d, 0)) / period;
  }
  if (al === 0) return 100;
  return 100 - 100 / (1 + ag / al);
}

function calcMACD(closes) {
  if (!closes || closes.length < 35) return null;
  const k12 = 2 / 13, k26 = 2 / 27, k9 = 0.2;
  let e12 = closes[0], e26 = closes[0];
  const line = [];
  for (let i = 0; i < closes.length; i++) {
    e12 = closes[i] * k12 + e12 * (1 - k12);
    e26 = closes[i] * k26 + e26 * (1 - k26);
    line.push(e12 - e26);
  }
  let sig = line[0];
  for (let i = 1; i < line.length; i++) sig = line[i] * k9 + sig * (1 - k9);
  const m = line[line.length - 1];
  return { macd: m, signal: sig, hist: m - sig };
}

function calcATR(klines, period) {
  period = period || 14;
  if (!klines || klines.length < period + 1) return null;
  const tr = function(i) { return Math.max(klines[i].high - klines[i].low, Math.abs(klines[i].high - klines[i - 1].close), Math.abs(klines[i].low - klines[i - 1].close)); };
  let a = 0;
  for (let i = 1; i <= period; i++) a += tr(i);
  a /= period;
  for (let i = period + 1; i < klines.length; i++) a = (a * (period - 1) + tr(i)) / period;
  return a;
}

function detectTrend(closes, ema20, ema50) {
  if (!closes || closes.length < 8) return 'neutral';
  const last = closes[closes.length - 1];
  const prev5 = closes[closes.length - 6];
  const prev10 = closes[closes.length - 11] || prev5;
  let score = 0;
  if (ema20 != null && ema50 != null) {
    if (ema20 > ema50) score += 2; else score -= 2;
    if (last > ema20) score += 1; else score -= 1;
  }
  if (last > prev5) score += 1; else if (last < prev5) score -= 1;
  if (last > prev10) score += 1; else if (last < prev10) score -= 1;
  if (score >= 2) return 'bullish';
  if (score <= -2) return 'bearish';
  return 'neutral';
}

function detectStructure(klines) {
  if (!klines || klines.length < 30) return '—';
  const sw = findSwings(klines.slice(-90), 3);
  const H = sw.highs.slice(-2), L = sw.lows.slice(-2);
  if (H.length < 2 || L.length < 2) return 'Seitwärts / gemischt';
  const hh = H[1].price > H[0].price, hl = L[1].price > L[0].price;
  if (hh && hl) return 'HH/HL (Aufwärts)';
  if (!hh && !hl) return 'LH/LL (Abwärts)';
  return 'Seitwärts / gemischt';
}

/** Find swing highs/lows for BOS + Fibonacci */
function findSwings(klines, lookback) {
  lookback = lookback || 5;
  const swings = { highs: [], lows: [] };
  if (!klines || klines.length < lookback * 2 + 1) return swings;
  for (let i = lookback; i < klines.length - lookback; i++) {
    let isHigh = true, isLow = true;
    for (let j = 1; j <= lookback; j++) {
      if (klines[i].high <= klines[i - j].high || klines[i].high <= klines[i + j].high) isHigh = false;
      if (klines[i].low >= klines[i - j].low || klines[i].low >= klines[i + j].low) isLow = false;
    }
    if (isHigh) swings.highs.push({ i: i, price: klines[i].high });
    if (isLow) swings.lows.push({ i: i, price: klines[i].low });
  }
  return swings;
}

/** Break of Structure: last swing high broken (bullish BOS) or last swing low broken (bearish BOS) */
function detectBOS(klines) {
  const swings = findSwings(klines, 4);
  if (!klines || klines.length < 20) return { bos: 'none', level: null };
  const last = klines[klines.length - 1].close;
  const recentHighs = swings.highs.slice(-3);
  const recentLows = swings.lows.slice(-3);
  if (recentHighs.length >= 1) {
    const lastSwingHigh = recentHighs[recentHighs.length - 1].price;
    if (last > lastSwingHigh * 1.001) return { bos: 'bullish', level: lastSwingHigh };
  }
  if (recentLows.length >= 1) {
    const lastSwingLow = recentLows[recentLows.length - 1].price;
    if (last < lastSwingLow * 0.999) return { bos: 'bearish', level: lastSwingLow };
  }
  return { bos: 'none', level: null };
}

/** Fibonacci retracement from last major swing (up-move or down-move) */
function calcFibonacci(klines) {
  if (!klines || klines.length < 25) return null;
  const slice = klines.slice(-40);
  let hi = -Infinity, lo = Infinity, hiIdx = 0, loIdx = 0;
  for (let i = 0; i < slice.length; i++) {
    if (slice[i].high > hi) { hi = slice[i].high; hiIdx = i; }
    if (slice[i].low < lo) { lo = slice[i].low; loIdx = i; }
  }
  const range = hi - lo;
  if (range <= 0) return null;
  const price = slice[slice.length - 1].close;
  // Direction of last major move
  const upMove = hiIdx > loIdx;
  const levels = {
    high: hi, low: lo,
    fib236: upMove ? hi - range * 0.236 : lo + range * 0.236,
    fib382: upMove ? hi - range * 0.382 : lo + range * 0.382,
    fib500: upMove ? hi - range * 0.5 : lo + range * 0.5,
    fib618: upMove ? hi - range * 0.618 : lo + range * 0.618,
    fib786: upMove ? hi - range * 0.786 : lo + range * 0.786,
    direction: upMove ? 'up' : 'down',
    nearFib: null
  };
  // Which fib is price near?
  const fibs = [
    { name: '23.6%', v: levels.fib236 },
    { name: '38.2%', v: levels.fib382 },
    { name: '50%', v: levels.fib500 },
    { name: '61.8%', v: levels.fib618 },
    { name: '78.6%', v: levels.fib786 }
  ];
  for (let f of fibs) {
    const dist = Math.abs(price - f.v) / price;
    if (dist < 0.004) { levels.nearFib = f.name; break; }
  }
  return levels;
}

/** Pullback: price retracing into EMA20/EMA50 or Fib zone after trend */
function detectPullback(klines, ema20, ema50, trend) {
  if (!klines || !ema20 || klines.length < 15) return { pullback: false, type: null };
  const price = klines[klines.length - 1].close;
  const distEma20 = Math.abs(price - ema20) / price;
  const distEma50 = ema50 != null ? Math.abs(price - ema50) / price : 1;
  if (trend === 'bullish' && price < ema20 && distEma20 < 0.012) {
    return { pullback: true, type: 'bullish_pullback_to_ema20' };
  }
  if (trend === 'bullish' && ema50 != null && price < ema50 * 1.005 && price > ema50 * 0.99) {
    return { pullback: true, type: 'bullish_pullback_to_ema50' };
  }
  if (trend === 'bearish' && price > ema20 && distEma20 < 0.012) {
    return { pullback: true, type: 'bearish_pullback_to_ema20' };
  }
  if (trend === 'bearish' && ema50 != null && price > ema50 * 0.995 && price < ema50 * 1.01) {
    return { pullback: true, type: 'bearish_pullback_to_ema50' };
  }
  return { pullback: false, type: null };
}

/** Support / Resistance from recent swings */
function calcSR(klines) {
  const swings = findSwings(klines, 4);
  const supports = swings.lows.slice(-4).map(function(s) { return s.price; }).sort(function(a,b){return b-a;});
  const resistances = swings.highs.slice(-4).map(function(s) { return s.price; }).sort(function(a,b){return a-b;});
  const price = klines[klines.length - 1].close;
  let nearestSupport = null, nearestResistance = null;
  for (let s of supports) { if (s < price) { nearestSupport = s; break; } }
  for (let r of resistances) { if (r > price) { nearestResistance = r; break; } }
  return { support: nearestSupport, resistance: nearestResistance, supports: supports, resistances: resistances };
}

function analyzeFromKlines(klines, key) {
  if (!klines || klines.length < 30) {
    state.mtf[key] = { trend: null, mom: null, rsi: null, macd: null, ema: null, vol: null, struct: null };
    return false;
  }
  const closes = klines.map(function(k) { return k.close; });
  const volumes = klines.map(function(k) { return k.volume; });
  const ema20 = calcEMA(closes, 20);
  const ema50 = calcEMA(closes, 50);
  const ema200 = closes.length >= 200 ? calcEMA(closes, 200) : null;
  const rsi = calcRSI(closes, 14);
  const macd = calcMACD(closes);
  const atr = calcATR(klines, 14);
  const trend = detectTrend(closes, ema20, ema50);
  const struct = detectStructure(klines);
  const momPct = ((closes[closes.length - 1] - closes[closes.length - 6]) / closes[closes.length - 6]) * 100;
  let mom = 'neutral';
  if (momPct > 0.25) mom = 'positiv';
  else if (momPct < -0.25) mom = 'negativ';
  const avgVol = volumes.slice(-20).reduce(function(a, b) { return a + b; }, 0) / 20;
  const lastVol = volumes[volumes.length - 1];
  const volLabel = lastVol > avgVol * 1.25 ? 'steigend' : lastVol < avgVol * 0.75 ? 'fallend' : 'normal';
  let emaStruct = '—';
  if (ema20 != null && ema50 != null) {
    emaStruct = ema20 > ema50 ? 'EMA20 > EMA50' : 'EMA20 < EMA50';
    if (ema200 != null) emaStruct += closes[closes.length - 1] > ema200 ? ' · über EMA200' : ' · unter EMA200';
  }
  const bos = detectBOS(klines);
  const fib = calcFibonacci(klines);
  const pullback = detectPullback(klines, ema20, ema50, trend);
  const sr = calcSR(klines);

  state.mtf[key] = {
    trend: trend, mom: mom,
    rsi: rsi != null ? Math.round(rsi * 10) / 10 : null,
    macd: macd ? (macd.hist > 0 ? 'positiv' : 'negativ') : null,
    ema: emaStruct, vol: volLabel, struct: struct, atr: atr,
    lastClose: closes[closes.length - 1], ema20: ema20, ema50: ema50, ema200: ema200, momPct: momPct,
    bos: bos, fib: fib, pullback: pullback, sr: sr,
    thrust: detectThrust(klines, atr), micro: detectMicro(klines, atr), engulf: detectEngulfing(klines), sweep: detectSweep(klines), div: detectDivergence(klines),
    klines: klines
  };
  return true;
}

/* ===== Zusätzliche Strategien ===== */
function detectThrust(k, atr) {
  if (!k || k.length < 40 || !atr) return { dir: 0, why: '' };
  const n = k.length - 1, c = k.map(function(x) { return x.close; });
  const d6 = (c[n] - c[n - 6]) / atr, d12 = (c[n] - c[n - 12]) / atr;
  const e = calcEMA(c, 20), e5 = calcEMA(c.slice(0, -5), 20);
  const m = calcMACD(c);
  const lows = k.slice(n - 21, n - 1).map(function(x) { return x.low; }), highs = k.slice(n - 21, n - 1).map(function(x) { return x.high; });
  const newLow = c[n] <= Math.min.apply(null, lows), newHigh = c[n] >= Math.max.apply(null, highs);
  if (d6 <= -2.0) return { dir: -1, why: 'steiler Abverkauf (' + d6.toFixed(1) + ' ATR in 6 Kerzen)' };
  if (c[n] < e && e < e5 && m && m.hist < 0 && d12 <= -1.0) return { dir: -1, why: 'Kurs unter fallender EMA20, MACD negativ' };
  if (newLow && d6 < -0.8) return { dir: -1, why: 'frisches 20-Kerzen-Tief' };
  if (d6 >= 2.0) return { dir: 1, why: 'steiler Anstieg (+' + d6.toFixed(1) + ' ATR in 6 Kerzen)' };
  if (c[n] > e && e > e5 && m && m.hist > 0 && d12 >= 1.0) return { dir: 1, why: 'Kurs über steigender EMA20, MACD positiv' };
  if (newHigh && d6 > 0.8) return { dir: 1, why: 'frisches 20-Kerzen-Hoch' };
  return { dir: 0, why: '' };
}
function detectMicro(k, atr) {
  if (!k || k.length < 40 || !atr) return { dir: 0, why: '' };
  const n = k.length - 1, c = k.map(function(x) { return x.close; });
  const e9 = calcEMA(c, 9), e21 = calcEMA(c, 21), d5 = (c[n] - c[n - 5]) / atr, d2 = (c[n] - c[n - 2]) / atr;
  let dn = 0, up = 0;
  for (let i = n - 4; i <= n; i++) { if (c[i] < c[i - 1]) dn++; if (c[i] > c[i - 1]) up++; }
  if ((c[n] < e9 && c[n] < e21 && d5 <= -0.8 && dn >= 3) || (c[n] < e9 && d2 <= -1.4)) return { dir: -1, why: '1M Mikro-Trend abwärts: Kurs unter EMA9/21, ' + dn + ' von 5 Kerzen fallend' };
  if ((c[n] > e9 && c[n] > e21 && d5 >= 0.8 && up >= 3) || (c[n] > e9 && d2 >= 1.4)) return { dir: 1, why: '1M Mikro-Trend aufwärts: Kurs über EMA9/21, ' + up + ' von 5 Kerzen steigend' };
  return { dir: 0, why: '' };
}
function detectEngulfing(k) {
  if (!k || k.length < 4) return 0;
  const a = k[k.length - 3], b = k[k.length - 2];
  if (a.close < a.open && b.close > b.open && b.close > a.open && b.open < a.close) return 1;
  if (a.close > a.open && b.close < b.open && b.close < a.open && b.open > a.close) return -1;
  return 0;
}
function detectSweep(k) {
  if (!k || k.length < 30) return 0;
  const sw = findSwings(k.slice(0, -1), 4), b = k[k.length - 2];
  const sl = sw.lows[sw.lows.length - 1], sh = sw.highs[sw.highs.length - 1];
  if (sl && b.low < sl.price && b.close > sl.price) return 1;
  if (sh && b.high > sh.price && b.close < sh.price) return -1;
  return 0;
}
function detectDivergence(k) {
  if (!k || k.length < 60) return 0;
  const closes = k.map(function(x) { return x.close; }), sw = findSwings(k, 4), n = k.length;
  const r = function(i) { return calcRSI(closes.slice(0, i + 1), 14); };
  const L = sw.lows.slice(-2), H = sw.highs.slice(-2);
  if (L.length === 2 && n - L[1].i < 25 && L[1].price < L[0].price && r(L[1].i) > r(L[0].i) + 2) return 1;
  if (H.length === 2 && n - H[1].i < 25 && H[1].price > H[0].price && r(H[1].i) < r(H[0].i) - 2) return -1;
  return 0;
}
