const COST_PCT = 0.24; // Hin + zurück: 2 × 0,1 % Gebühr + 2 × 0,02 % Slippage
function persistHistory() { try { localStorage.setItem('dt_signal_hist', JSON.stringify(state.signalHistory.slice(0, 80))); } catch (e) {} }
function loadHistory() {
  try { const raw = localStorage.getItem('dt_signal_hist'); if (raw) state.signalHistory = JSON.parse(raw) || []; } catch (e) { state.signalHistory = []; }
  renderHistory(); renderStats();
}
function saveSignalToHistory(type, strength, scalp) {
  if (type !== 'LONG' && type !== 'SHORT') return;
  const su = state.setup, price = state.price;
  if (!price || !su || !su.sl || !su.tp1) return;
  const now = Date.now();
  const last = state.signalHistory.find(function(h) { return h.symbol === state.symbol && h.status !== 'void'; });
  if (last && (last.status === 'open' || now - (last.closedTs || last.ts) < (last.sc ? 2 : 5) * 60000)) return;
  state.signalHistory.unshift({ id: now + '_' + Math.random().toString(36).slice(2, 7), ts: now, time: nowStr(), asset: state.displayName, symbol: state.symbol,
    signal: type, price: price, strength: strength, sl: su.sl, tp: su.tp1, sc: !!scalp, status: 'open', exitPrice: null, resultPct: null, r: null, why: '' });
  if (state.signalHistory.length > 80) state.signalHistory.pop();
  persistHistory(); renderHistory(); renderStats();
}
function evaluatePendingSignals() {
  const p = state.price;
  if (!p) return;
  const now = Date.now();
  let changed = false;
  state.signalHistory.forEach(function(h) {
    if (h.status !== 'open' || !h.sl || !h.tp) return;
    const limit = h.sc ? 30 * 60e3 : 4 * 3600e3;
    if (h.symbol !== state.symbol) { if (now - h.ts > limit) { h.status = 'void'; changed = true; } return; }
    const d = h.signal === 'LONG' ? 1 : -1;
    let exit = null, why = '';
    if (d * (p - h.sl) <= 0) { exit = h.sl; why = 'Stop'; }
    else if (d * (p - h.tp) >= 0) { exit = h.tp; why = 'Ziel'; }
    else if (now - h.ts > limit) { exit = p; why = 'Zeit'; }
    if (exit == null) return;
    const risk = Math.abs(h.price - h.sl) / h.price * 100, gross = d * (exit - h.price) / h.price * 100;
    h.exitPrice = exit; h.resultPct = gross - COST_PCT; h.r = (gross - COST_PCT) / Math.max(risk, 0.01); h.why = why; h.closedTs = now;
    h.status = h.r > 0 ? 'win' : 'loss';
    changed = true;
  });
  if (changed) { persistHistory(); renderHistory(); renderStats(); }
}
function renderStats() {
  const closed = state.signalHistory.filter(function(h) { return h.status === 'win' || h.status === 'loss'; });
  const open = state.signalHistory.filter(function(h) { return h.status === 'open'; }).length;
  const wins = closed.filter(function(h) { return h.status === 'win'; }).length, total = closed.length;
  const rate = total ? Math.round(wins / total * 100) : null;
  const grp = function(sig) { const c = closed.filter(function(h) { return h.signal === sig; }), w = c.filter(function(h) { return h.status === 'win'; }).length; return w + 'W / ' + (c.length - w) + 'L · ' + (c.length ? Math.round(w / c.length * 100) + '%' : '—'); };
  const avg = function(a) { return a.length ? a.reduce(function(q, h) { return q + (h.r || 0); }, 0) / a.length : null; };
  const elT = document.getElementById('stat-total');
  if (!elT) return;
  elT.textContent = String(total);
  document.getElementById('stat-open').textContent = String(open);
  const elR = document.getElementById('stat-winrate');
  elR.textContent = rate != null ? rate + '%' : '—';
  elR.className = 'text-lg font-bold ' + (rate == null ? 'text-slate-400' : rate >= 55 ? 'text-green-400' : rate >= 45 ? 'text-yellow-400' : 'text-red-400');
  document.getElementById('stat-long').textContent = grp('LONG');
  document.getElementById('stat-short').textContent = grp('SHORT');
  const note = document.getElementById('stat-note');
  if (!note) return;
  if (!total) { note.textContent = 'Noch keine abgeschlossenen Signale. Jedes LONG/SHORT wird mit Stop-Loss und Ziel 1 live verfolgt und nach Kosten (' + COST_PCT + ' %) gemessen.'; return; }
  const all = avg(closed), sc = closed.filter(function(h) { return h.sc; }), nm = closed.filter(function(h) { return !h.sc; });
  note.textContent = 'Ø ' + (all >= 0 ? '+' : '') + all.toFixed(2) + ' R pro Signal nach ' + COST_PCT + ' % Kosten' + (nm.length ? ' · normal ' + avg(nm).toFixed(2) + ' R (' + nm.length + ')' : '') + (sc.length ? ' · ⚡ Scalps ' + avg(sc).toFixed(2) + ' R (' + sc.length + ')' : '') + '. Treffer = Ziel 1 vor Stop. Erst ab ca. 30–50 Signalen aussagekräftig.';
}
