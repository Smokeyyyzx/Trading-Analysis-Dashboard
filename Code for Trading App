function generateSignal() {
  const isCrypto = state.symbol.startsWith('BINANCE:');
  if (isCrypto && state.dataStatus === 'offline') {
    setSignal('WAIT', 0, ['🔴 LIVE-DATEN NICHT VERFÜGBAR', 'Kein Preis-Feed → Signal deaktiviert'], 'Ohne aktuelle Marktdaten wird kein Setup erzeugt.');
    return;
  }
  const t3 = state.mtf['3'] || {};
  const t5 = state.mtf['5'] || {};
  const t1h = state.mtf['60'] || {};
  const t15 = state.mtf['15'] || {};
  const th5 = (t5.thrust && t5.thrust.dir) || 0, th3 = (t3.thrust && t3.thrust.dir) || 0;
  const t1 = state.mtf['1'] || {};
  const mic = (t1.micro && t1.micro.dir) || 0;
  const fl60 = flowRatio(60), fl180 = flowRatio(180);
  const flowDir = (fl60 >= 0.22 && fl180 >= 0.05) ? 1 : (fl60 <= -0.22 && fl180 <= -0.05) ? -1 : 0;
  const flowStrong = flowDir !== 0 && Math.abs(fl60) >= 0.4;
  const obDir = flow.ob > 0.25 ? 1 : flow.ob < -0.25 ? -1 : 0;
  const vw = calcVWAP(klineCache['5m']), pxNow = state.price || t5.lastClose;
  const vwDir = vw && pxNow ? (pxNow > vw * 1.0003 ? 1 : pxNow < vw * 0.9997 ? -1 : 0) : 0;
  if (!t5.trend && !t1h.trend && !t3.trend) {
    setSignal('WAIT', 5, ['⏳ Warte auf Kerzen-Daten …'], 'Daten werden geladen.');
    return;
  }

  // ── Multi-Strategy Scores ──
  let trendScore = 0;      // -10 .. +10
  let bosScore = 0;
  let pullbackScore = 0;
  let fibScore = 0;
  let momentumScore = 0;
  let volumeScore = 0;
  let structureScore = 0;
  const reasons = [];
  const risks = [];
  const strategyHits = [];

  // Kontext für Einstiegs-Strategien: kurzfristiger Chart entscheidet, 1H/15M sperren nur, wenn BEIDE dagegen stehen
  const ctxL = t5.trend !== 'bearish' && th5 >= 0 && th3 >= 0 && !(t1h.trend === 'bearish' && t15.trend === 'bearish');
  const ctxS = t5.trend !== 'bullish' && th5 <= 0 && th3 <= 0 && !(t1h.trend === 'bullish' && t15.trend === 'bullish');

  // 1) Multi-Timeframe: Primär 3M + 5M (Daytrade), 15M + 1H nur Kontext. Long und Short werden gleich behandelt.
  const tw = function(t, w, label, primary) {
    if (t.trend === 'bullish') { trendScore += w; reasons.push('✓ ' + label + '-Trend: bullish' + (primary ? ' (Primär-TF)' : '')); }
    else if (t.trend === 'bearish') { trendScore -= w; reasons.push('✓ ' + label + '-Trend: bearish' + (primary ? ' (Primär-TF)' : '')); }
    else reasons.push('• ' + label + '-Trend: neutral');
  };
  tw(t3, 2.5, '3M', true); tw(t5, 3, '5M', true); tw(t15, 1.2, '15M'); tw(t1h, 1, '1H (nur Kontext)');
  if (t1h.trend === 'neutral') risks.push('⚠️ 1H ohne klaren Trend');
  if (t3.trend === 'bullish' && t5.trend === 'bullish') { trendScore += 2.5; strategyHits.push('Trend-Alignment LONG (3M+5M)'); }
  if (t3.trend === 'bearish' && t5.trend === 'bearish') { trendScore -= 2.5; strategyHits.push('Trend-Alignment SHORT (3M+5M)'); }
  if (t1h.trend === 'bullish' && t5.trend === 'bearish') risks.push('⚠️ 1H bullish aber 5M bearish — Konflikt');
  if (t1h.trend === 'bearish' && t5.trend === 'bullish') risks.push('⚠️ 1H bearish aber 5M bullish — Konflikt');

  // 2) Break of Structure (BOS)
  if (t5.bos && t5.bos.bos === 'bullish') {
    bosScore += 2.5;
    reasons.push('✓ 5M Break of Structure bullish (über Swing-High)');
    strategyHits.push('BOS bullish');
  }
  if (t5.bos && t5.bos.bos === 'bearish') {
    bosScore -= 2.5;
    reasons.push('✓ 5M Break of Structure bearish (unter Swing-Low)');
    strategyHits.push('BOS bearish');
  }
  if (t1h.bos && t1h.bos.bos === 'bullish') {
    bosScore += 1.5;
    reasons.push('✓ 1H BOS bullish');
  }
  if (t1h.bos && t1h.bos.bos === 'bearish') {
    bosScore -= 1.5;
    reasons.push('✓ 1H BOS bearish');
  }

  // 3) Pullback-Strategie (Einstieg in Trend nach Korrektur)
  if (t5.pullback && t5.pullback.pullback) {
    if (t5.pullback.type && t5.pullback.type.indexOf('bullish') >= 0 && ctxL) {
      pullbackScore += 2.5;
      reasons.push('✓ Bullish Pullback an EMA (Kurzfrist-Trend aufwärts)');
      strategyHits.push('Pullback LONG');
    }
    if (t5.pullback.type && t5.pullback.type.indexOf('bearish') >= 0 && ctxS) {
      pullbackScore -= 2.5;
      reasons.push('✓ Bearish Pullback an EMA (Kurzfrist-Trend abwärts)');
      strategyHits.push('Pullback SHORT');
    }
  } else if (t1h.trend === 'bullish' && t3.trend === 'bearish') {
    // soft pullback note
    reasons.push('ℹ️ 3M Korrektur im 1H-Aufwärtstrend (noch kein bestätigter Pullback-Entry)');
  }

  // 4) Fibonacci
  if (t5.fib) {
    if (t5.fib.nearFib) {
      reasons.push('✓ Preis nahe Fibonacci ' + t5.fib.nearFib);
      if (t5.fib.direction === 'up' && (t5.fib.nearFib === '38.2%' || t5.fib.nearFib === '50%' || t5.fib.nearFib === '61.8%')) {
        if (ctxL) {
          fibScore += 2;
          strategyHits.push('Fib-Retracement LONG (' + t5.fib.nearFib + ')');
          reasons.push('✓ Fib-Retracement in Aufwärtsbewegung — klassische Long-Zone');
        }
      }
      if (t5.fib.direction === 'down' && (t5.fib.nearFib === '38.2%' || t5.fib.nearFib === '50%' || t5.fib.nearFib === '61.8%')) {
        if (ctxS) {
          fibScore -= 2;
          strategyHits.push('Fib-Retracement SHORT (' + t5.fib.nearFib + ')');
          reasons.push('✓ Fib-Retracement in Abwärtsbewegung — klassische Short-Zone');
        }
      }
    } else {
      reasons.push('• Preis nicht an einem der Haupt-Fib-Level (23.6–78.6%)');
    }
  }

  // 5) Momentum (RSI + MACD)
  if (t5.rsi != null) {
    const bullOk = t5.trend !== 'bearish' && th5 >= 0 && th3 >= 0, bearOk = t5.trend !== 'bullish' && th5 <= 0 && th3 <= 0;
    if (t5.rsi <= 35 && !bullOk) reasons.push('• 5M RSI ' + t5.rsi + ' überverkauft, aber der Kurs fällt noch → kein Kaufgrund (nicht ins fallende Messer greifen)');
    else if (t5.rsi >= 65 && !bearOk) reasons.push('• 5M RSI ' + t5.rsi + ' überkauft, aber der Kurs steigt noch → kein Verkaufsgrund');
    else if (t5.rsi <= 28) { momentumScore += 2; reasons.push('✓ 5M RSI stark überverkauft (' + t5.rsi + ')'); }
    else if (t5.rsi <= 35) { momentumScore += 1; reasons.push('• 5M RSI überverkauft-Zone (' + t5.rsi + ')'); }
    else if (t5.rsi >= 72) { momentumScore -= 2; reasons.push('✓ 5M RSI stark überkauft (' + t5.rsi + ')'); }
    else if (t5.rsi >= 65) { momentumScore -= 1; reasons.push('• 5M RSI überkauft-Zone (' + t5.rsi + ')'); }
    else reasons.push('• 5M RSI neutral (' + t5.rsi + ')');
  }
  if (t5.macd === 'positiv') { momentumScore += 1; reasons.push('✓ 5M MACD positiv'); }
  if (t5.macd === 'negativ') { momentumScore -= 1; reasons.push('✓ 5M MACD negativ'); }

  // 6) Volumen-Bestätigung
  const volDir = th5 !== 0 ? th5 : (mic !== 0 ? mic : (trendScore > 0.5 ? 1 : trendScore < -0.5 ? -1 : 0));
  if (t5.vol === 'steigend' && volDir) {
    volumeScore += 1.2 * volDir;
    reasons.push('✓ Volumen steigt – bestätigt die ' + (volDir > 0 ? 'Aufwärts' : 'Abwärts') + 'bewegung');
  } else if (t5.vol === 'fallend') {
    volumeScore -= 0.5 * volDir;
    reasons.push('• Volumen fallend — schwächere Bestätigung');
    risks.push('⚠️ Fallendes Volumen');
  }

  // 7) Struktur HH/HL
  if (t5.struct && t5.struct.indexOf('Aufwärts') >= 0) { structureScore += 1.5; reasons.push('✓ 5M Marktstruktur: Higher Highs / Higher Lows'); }
  if (t5.struct && t5.struct.indexOf('Abwärts') >= 0) { structureScore -= 1.5; reasons.push('✓ 5M Marktstruktur: Lower Highs / Lower Lows'); }
  if (t1h.struct && t1h.struct.indexOf('Aufwärts') >= 0) {
    structureScore += 0.8;
    reasons.push('✓ 1H Marktstruktur: Higher Highs / Higher Lows');
  }
  if (t1h.struct && t1h.struct.indexOf('Abwärts') >= 0) {
    structureScore -= 0.8;
    reasons.push('✓ 1H Marktstruktur: Lower Highs / Lower Lows');
  }

  // 8) Support/Resistance Nähe
  if (t5.sr) {
    if (t5.sr.support && t5.lastClose) {
      const distS = (t5.lastClose - t5.sr.support) / t5.lastClose;
      if (distS < 0.005 && distS > 0) {
        reasons.push('✓ Preis nahe Support (' + formatPrice(t5.sr.support) + ')');
        if (ctxL) { trendScore += 0.8; strategyHits.push('Support-Hold LONG'); }
      }
    }
    if (t5.sr.resistance && t5.lastClose) {
      const distR = (t5.sr.resistance - t5.lastClose) / t5.lastClose;
      if (distR < 0.005 && distR > 0) {
        reasons.push('✓ Preis nahe Resistance (' + formatPrice(t5.sr.resistance) + ')');
        if (ctxS) { trendScore -= 0.8; strategyHits.push('Resistance-Reject SHORT'); }
        else risks.push('⚠️ Resistance in unmittelbarer Nähe');
      }
    }
  }

  // 9-11) Candle-Muster, Liquidity Sweep, RSI-Divergenz
  let patScore = 0, sweepScore = 0, divScore = 0;
  const rev = function(v) { return (v > 0 && (t5.trend === 'bearish' || th5 < 0 || th3 < 0)) || (v < 0 && (t5.trend === 'bullish' || th5 > 0 || th3 > 0)) ? 0 : (v || 0); };
  const gEng = rev(t5.engulf), gSw = rev(t5.sweep), gDiv = rev(t5.div);

  if (gEng) { patScore = gEng * 1.2; reasons.push('✓ 5M Engulfing-Kerze ' + (gEng > 0 ? 'bullish' : 'bearish')); strategyHits.push(gEng > 0 ? 'Engulfing LONG' : 'Engulfing SHORT'); }
  if (gSw) { sweepScore = gSw * 1.8; reasons.push('✓ 5M Liquidity Sweep: ' + (gSw > 0 ? 'Tief ausgeräumt und zurück (bullish)' : 'Hoch ausgeräumt und zurück (bearish)')); strategyHits.push(gSw > 0 ? 'Liquidity-Sweep LONG' : 'Liquidity-Sweep SHORT'); }
  if (gDiv) { divScore = gDiv * 1.8; reasons.push('✓ 5M RSI-Divergenz ' + (gDiv > 0 ? 'bullish' : 'bearish')); strategyHits.push(gDiv > 0 ? 'RSI-Divergenz LONG' : 'RSI-Divergenz SHORT'); }
  const thScore = th5 * 2.5 + th3 * 1;
  if (th5) { reasons.push('⚠️ 5M: ' + t5.thrust.why + (th5 < 0 ? ' → Kurs fällt stark, nicht kaufen' : ' → Kurs steigt stark, nicht shorten')); strategyHits.push(th5 < 0 ? 'Abwärts-Schub SHORT' : 'Aufwärts-Schub LONG'); }
  if (th3) reasons.push('⚠️ 3M: ' + t3.thrust.why);
  const microScore = mic * 2.5 + flowDir * (flowStrong ? 2 : 1.2) + obDir * 0.5 + vwDir * 0.8;
  if (mic) { reasons.push('⚠️ ' + t1.micro.why); strategyHits.push(mic < 0 ? 'Mikro-Abwärtstrend SHORT' : 'Mikro-Aufwärtstrend LONG'); }
  if (flowDir) { reasons.push('⚠️ Order-Flow (60 s): ' + (fl60 * 100).toFixed(0) + '% – ' + (flowDir < 0 ? 'Verkäufer sind aggressiver' : 'Käufer sind aggressiver')); strategyHits.push(flowDir < 0 ? 'Order-Flow SHORT' : 'Order-Flow LONG'); }
  if (obDir) reasons.push('• Orderbuch: ' + (obDir < 0 ? 'Verkaufsdruck' : 'Kaufdruck') + ' (' + (flow.ob * 100).toFixed(0) + '%)');
  if (vwDir) reasons.push('• Preis ' + (vwDir > 0 ? 'über' : 'unter') + ' Tages-VWAP (' + formatPrice(vw) + ')');
  const sg = function(x, t) { return x > t ? 1 : x < -t ? -1 : 0; };
  state.votes = [
    { n: 'Trend-Alignment 3M/5M (+15M/1H)', v: sg(trendScore, 1.5) },
    { n: 'Break of Structure (BOS)', v: sg(bosScore, 1) },
    { n: 'Pullback an EMA', v: sg(pullbackScore, 1) },
    { n: 'Fibonacci-Retracement', v: sg(fibScore, 1) },
    { n: 'Marktstruktur HH/HL – LH/LL', v: sg(structureScore, 1) },
    { n: 'Momentum (RSI + MACD)', v: sg(momentumScore, 0.9) },
    { n: 'Volumen-Bestätigung', v: t5.vol === 'steigend' ? volDir : 0 },
    { n: 'Kurs-Schub 3M/5M (Abverkauf / Anstieg)', v: th5 || th3 },
    { n: 'Engulfing-Kerze', v: gEng },
    { n: 'Liquidity Sweep', v: gSw },
    { n: 'RSI-Divergenz', v: gDiv },
    { n: 'Mikro-Trend 1M (EMA9/21, Kerzenfolge)', v: mic },
    { n: 'Order-Flow (Käufer vs. Verkäufer, 60 s)', v: flowDir },
    { n: 'Orderbuch-Druck', v: obDir },
    { n: 'VWAP (Tages-Durchschnittspreis)', v: vwDir }
  ];
  const Lv = state.votes.filter(function(x) { return x.v > 0; }).length, Sv = state.votes.filter(function(x) { return x.v < 0; }).length, net = Lv - Sv;

  // ── Volatilitäts-Filter (streng) ──
  const atr = t5.atr;
  if (atr && t5.lastClose) {
    const atrPct = (atr / t5.lastClose) * 100;
    state.volatility = atrPct > 1.8 ? 'Hoch' : atrPct < 0.35 ? 'Niedrig' : 'Mittel';
    document.getElementById('volatility-level').textContent = state.volatility;
    if (atrPct > 2.2) {
      risks.push('🔴 Sehr hohe Volatilität (ATR ' + atrPct.toFixed(2) + '%) — kein Setup');
      setSignal('WAIT', 15, reasons.concat(risks),
        'Extrem hohe Volatilität. Bei so starken Schwankungen ist das Risiko zu hoch. ABWARTEN.');
      state.risk = { level: 'HIGH', reasons: risks };
      renderRisk();
      calcSetup(null);
      return;
    }
    if (atrPct > 1.4) risks.push('⚠️ Erhöhte Volatilität (ATR ' + atrPct.toFixed(2) + '%)');
  }

  if (t1h.trend === 'bullish') state.regime = 'Trending ↑';
  else if (t1h.trend === 'bearish') state.regime = 'Trending ↓';
  else state.regime = 'Seitwärts / unklar';
  document.getElementById('market-regime').textContent = state.regime;

  // ── Gesamt-Score ──
  const total = trendScore + bosScore + pullbackScore + fibScore + momentumScore + volumeScore + structureScore + patScore + sweepScore + divScore + thScore + microScore;

  // Mindest-Anforderungen für LONG/SHORT (viel strenger)
  // Mindestens 2 unabhängige Strategien müssen in die gleiche Richtung zeigen
  const longStrategies = strategyHits.filter(function(s) { return s.indexOf('LONG') >= 0 || s.indexOf('bullish') >= 0; }).length;
  const shortStrategies = strategyHits.filter(function(s) { return s.indexOf('SHORT') >= 0 || s.indexOf('bearish') >= 0; }).length;

  const down5 = th5 < 0 || th3 < 0 || (th5 <= 0 && (t5.trend === 'bearish' || (t15.trend === 'bearish' && t5.trend !== 'bullish') || (t5.struct && t5.struct.indexOf('Abwärts') >= 0 && t3.trend !== 'bullish')));
  const up5 = th5 > 0 || th3 > 0 || (th5 >= 0 && (t5.trend === 'bullish' || (t15.trend === 'bullish' && t5.trend !== 'bearish') || (t5.struct && t5.struct.indexOf('Aufwärts') >= 0 && t3.trend !== 'bearish')));
  // Höhere Zeitrahmen sperren nur, wenn 1H UND 15M dagegen stehen – außer 3M+5M sind sich einig und Order-Flow/Mikro-Trend bestätigen
  const cL = t3.trend === 'bullish' && t5.trend === 'bullish' && (flowDir > 0 || mic > 0);
  const cS = t3.trend === 'bearish' && t5.trend === 'bearish' && (flowDir < 0 || mic < 0);
  const htfOkL = !(t1h.trend === 'bearish' && t15.trend === 'bearish') || cL;
  const htfOkS = !(t1h.trend === 'bullish' && t15.trend === 'bullish') || cS;
  let type = 'WAIT';
  let strength = 0;

  // Strenge Regeln:
  // - total >= 5 und mind. 2 Long-Strategien UND 1H nicht gegen LONG
  // - ODER total <= -5 und mind. 2 Short-Strategien UND 1H nicht gegen SHORT
  if (total >= 10 && longStrategies >= 1 && htfOkL && !down5 && net >= 2 && mic >= 0 && flowDir >= 0) {
    type = 'LONG';
    strength = Math.min(90, Math.round(40 + total * 5 + longStrategies * 5));
  } else if (total <= -10 && shortStrategies >= 1 && htfOkS && !up5 && net <= -2 && mic <= 0 && flowDir <= 0) {
    type = 'SHORT';
    strength = Math.min(90, Math.round(40 + Math.abs(total) * 5 + shortStrategies * 5));
  } else {
    type = 'WAIT';
    strength = Math.min(45, Math.round(10 + Math.abs(total) * 3));
    if (longStrategies < 1 && shortStrategies < 1) {
      reasons.push('⚠️ Keine Strategie liefert ein Setup → ABWARTEN');
    }
    if (Math.abs(total) < 10) {
      reasons.push('⚠️ Gesamt-Score zu schwach (' + total.toFixed(1) + ') — Schwelle ±10');
    }
    if (!htfOkL && total > 0) {
      reasons.push('⚠️ 1H und 15M bearish blockieren das Long-Setup');
    }
    if (!htfOkS && total < 0) {
      reasons.push('⚠️ 1H und 15M bullish blockieren das Short-Setup');
    }
    if (total > 0 && down5) reasons.push('⚠️ Kurs fällt gerade (3M/5M-Schub, 5M/15M-Trend oder Struktur abwärts): Long wäre gegen den Trend → nicht einsteigen');
    if (total < 0 && up5) reasons.push('⚠️ Kurs steigt gerade (3M/5M-Schub, 5M/15M-Trend oder Struktur aufwärts): Short wäre gegen den Trend → nicht einsteigen');
  }

  let scalp = false;
  if (type === 'WAIT') {
    if ((total >= 10 || total <= -10) && Math.abs(net) < 2) reasons.push('⚠️ Strategien uneinig (' + Lv + ' LONG : ' + Sv + ' SHORT) → nicht einsteigen');
    if (total > 0 && (mic < 0 || flowDir < 0)) reasons.push('⚠️ Kurzfristig dominieren Verkäufer (1M-Trend / Order-Flow) → Long jetzt nicht sinnvoll');
    if (total < 0 && (mic > 0 || flowDir > 0)) reasons.push('⚠️ Kurzfristig dominieren Käufer (1M-Trend / Order-Flow) → Short jetzt nicht sinnvoll');
    // Scalp: schneller kurzer Schub, auch gegen den größeren Trend, wenn 1M-Trend UND Order-Flow klar übereinstimmen
    const sd = microScore <= -4 ? -1 : microScore >= 4 ? 1 : 0;
    if (sd && mic === sd && flowDir === sd && sd * net >= 2 && sd * total > -6 &&
        (sd < 0 ? (th5 <= 0 && t5.trend !== 'bullish') : (th5 >= 0 && t5.trend !== 'bearish'))) {
      type = sd > 0 ? 'LONG' : 'SHORT'; scalp = true;
      strength = Math.min(80, Math.round(45 + Math.abs(microScore) * 5));
      for (let i = reasons.length - 1; i >= 0; i--) if (/nicht einsteigen|blockiert|Schwelle|Keine Strategie|nicht sinnvoll/.test(reasons[i])) reasons.splice(i, 1);
      reasons.unshift('⚡ SCALP: kurzer ' + (sd < 0 ? 'Abwärts' : 'Aufwärts') + 'schub – 1M-Trend und Order-Flow stimmen überein. Nur kurz halten, kleine Ziele.');
    }
  }

  const cur = state.signal.type;
  if (type !== cur) {
    state._cand = (state._cand && state._cand.type === type) ? { type: type, n: state._cand.n + 1 } : { type: type, n: 1 };
    if (type !== 'WAIT' && state._cand.n < 3) { type = 'WAIT'; reasons.push('ℹ️ Neues Signal wird bestätigt (' + state._cand.n + '/3)'); }
  } else state._cand = null;

  if (type === 'WAIT') scalp = false;
  // Strategie-Übersicht in Reasons
  if (strategyHits.length) {
    reasons.unshift('Strategien: ' + strategyHits.join(' · '));
  } else {
    reasons.unshift('Strategien: keine klare Übereinstimmung');
  }
  reasons.push('Score: Trend ' + trendScore.toFixed(1) + ' | BOS ' + bosScore.toFixed(1) + ' | Pullback ' + pullbackScore.toFixed(1) + ' | Fib ' + fibScore.toFixed(1) + ' | Mom ' + momentumScore.toFixed(1) + ' | Vol ' + volumeScore.toFixed(1) + ' | Strukt ' + structureScore.toFixed(1) + ' | Mikro ' + microScore.toFixed(1) + ' → Σ ' + total.toFixed(1));

  let riskLevel = 'MEDIUM';
  if (risks.some(function(r) { return r.indexOf('Sehr hohe') >= 0 || r.indexOf('🔴') >= 0; })) riskLevel = 'HIGH';
  else if (strength >= 70 && risks.length === 0 && type !== 'WAIT') riskLevel = 'LOW';
  else if (type === 'WAIT') riskLevel = 'MEDIUM';

  state.risk = { level: riskLevel, reasons: risks.length ? risks : ['Keine besonderen Risiko-Flags'] };
  renderRisk();

  const explanation = (scalp ? '⚡ SCALP-Signal (kurzer Schub, Ziele nach 3M-ATR, nur kurz halten). ' : '') + buildExplanation(type, t1h, t5, t3, total, strategyHits, longStrategies, shortStrategies);
  setSignal(type, strength, reasons, explanation);
  state._levelBias = state.signal.type !== 'WAIT' ? state.signal.type : (total < 0 ? 'SHORT' : 'LONG');
  calcSetup(type, false, scalp);
  updatePositionMgmt(state.signal.type, t1h, t5, t3, total, down5, up5, net, t5.atr, { mic: mic, flow: flowDir, fl60: fl60 });
  const mvTp = state.setup && state.setup.tp1 && state.price ? Math.abs(state.setup.tp1 - state.price) / state.price * 100 : null;
  if (state.signal.type !== 'WAIT' && mvTp != null && mvTp < 2 * COST_PCT) {
    state.risk.reasons = state.risk.reasons.filter(function(r) { return r.indexOf('Gebühren') < 0 && r.indexOf('Keine besonderen') < 0; });
    state.risk.reasons.push('⚠️ Gebühren fressen den Gewinn: Ziel 1 = ' + mvTp.toFixed(2) + ' %, Kosten ≈ ' + COST_PCT + ' % (Spot, 0,1 %/Seite). Nur mit niedrigen Gebühren / Maker-Orders sinnvoll.');
    renderRisk();
  }
  renderVotes(type, scalp);
  if (state.signal.type !== 'WAIT') saveSignalToHistory(state.signal.type, strength, scalp);
}

function buildExplanation(type, t1h, t5, t3, total, strategyHits, longS, shortS) {
  strategyHits = strategyHits || [];
  longS = longS || 0;
  shortS = shortS || 0;
  if (type === 'WAIT') {
    return 'ABWARTEN (Score Σ ' + (total != null ? total.toFixed(1) : '?') + '). ' + (total >= 1 ? 'Tendenz leicht LONG. ' : total <= -1 ? 'Tendenz leicht SHORT. ' : 'Keine Tendenz. ') +
      'Es gibt nicht genug übereinstimmende Strategien (Long-Hits: ' + longS + ', Short-Hits: ' + shortS + '). ' +
      'Benötigt werden mindestens 1 Strategie-Treffer (Trend-Alignment, BOS, Pullback, Fibonacci, Support/Resistance) plus ein Score von ±10. ' +
      'Lieber kein Trade als ein schlecht abgesicherter. Warte auf klarere Ausrichtung.';
  }
  const dir = type === 'LONG' ? 'LONG' : 'SHORT';
  let text = dir + '-Setup (Score Σ ' + total.toFixed(1) + ', ' + (type === 'LONG' ? longS : shortS) + ' Strategie-Hits). ';
  text += 'Aktive Strategien: ' + (strategyHits.length ? strategyHits.join(', ') : '—') + '. ';
  if (t1h.trend) text += '1H-Trend ist ' + t1h.trend + '. ';
  if (t5.trend) text += '5M-Trend ist ' + t5.trend + '. ';
  if (t5.bos && t5.bos.bos !== 'none') text += 'Break of Structure auf 5M: ' + t5.bos.bos + '. ';
  if (t5.pullback && t5.pullback.pullback) text += 'Pullback an EMA erkannt. ';
  if (t5.fib && t5.fib.nearFib) text += 'Preis nahe Fib ' + t5.fib.nearFib + '. ';
  text += 'Stop-Loss und Take-Profit sind ATR-basiert. Dies ist keine Garantie — immer eigenes Risiko-Management nutzen.';
  return text;
}

function updatePositionMgmt(type, t1h, t5, t3, total, fallingHard, risingHard, netVotes, atr, press) {
  press = press || { mic: 0, flow: 0, fl60: 0 };
  const pDown = press.mic < 0 || press.flow < 0, pUp = press.mic > 0 || press.flow > 0;
  const pTxt = 'Order-Flow ' + Math.round(press.fl60 * 100) + '%' + (press.mic ? ', 1M-Mikro-Trend ' + (press.mic < 0 ? '↓' : '↑') : '');
  const elL = document.getElementById('mgmt-long');
  const elS = document.getElementById('mgmt-short');
  const elU = document.getElementById('mgmt-until');
  if (!elL || !elS || !elU) return;

  const price = (t5.lastClose != null ? t5.lastClose : state.price);
  const a = atr || t5.atr;
  if (price == null || a == null || !(a > 0)) {
    elL.textContent = 'Warte auf Preis/ATR …';
    elS.textContent = 'Warte auf Preis/ATR …';
    elU.textContent = '—';
    return;
  }

  const longSlTight = price - a * 0.5;
  const longSlNorm = price - a * 1.2;
  const longSlStruct = (t5.sr && t5.sr.support && t5.sr.support < price) ? (t5.sr.support - a * 0.1) : longSlNorm;
  const shortSlTight = price + a * 0.5;
  const shortSlNorm = price + a * 1.2;
  const shortSlStruct = (t5.sr && t5.sr.resistance && t5.sr.resistance > price) ? (t5.sr.resistance + a * 0.1) : shortSlNorm;
  const longTp1 = price + a * 1.6;
  const longTp2 = price + a * 2.8;
  const shortTp1 = price - a * 1.6;
  const shortTp2 = price - a * 2.8;

  const momFlipDown = fallingHard || (t5.macd === 'negativ' && t3.trend === 'bearish')
    || (t5.momPct != null && t5.momPct < -0.25 && t5.trend === 'bearish')
    || (t5.vol === 'steigend' && t5.trend === 'bearish');
  const momFlipUp = risingHard || (t5.macd === 'positiv' && t3.trend === 'bullish')
    || (t5.momPct != null && t5.momPct > 0.25 && t5.trend === 'bullish');

  let longTxt = '', shortTxt = '', untilTxt = '';

  if (type === 'SHORT' || momFlipDown) {
    longTxt = '🔴 SOFORT eng machen / raus erwägen — Momentum dreht nach unten.<br>'
      + '<b>Stop-Loss JETZT:</b> $' + formatPrice(longSlTight) + ' (eng)<br>'
      + '<b>Spätestens raus unter:</b> $' + formatPrice(longSlStruct) + '<br>'
      + 'Aktuell ca. $' + formatPrice(price) + '. Nicht auf Erholung warten, wenn 3M+5M fallen.';
  } else if (pDown && (type === 'LONG' || total >= 1)) {
    longTxt = '🟠 Vorsicht: Verkäufer dominieren kurzfristig (' + pTxt + ').<br>'
      + '<b>Stop eng:</b> $' + formatPrice(longSlTight) + '<br>'
      + 'Falls im Plus: Teilgewinn sichern. <b>Nicht nachkaufen.</b><br>'
      + 'Drehen 3M + 5M ebenfalls nach unten: raus.';
  } else if (type === 'LONG') {
    longTxt = '🟢 Long halten möglich.<br>'
      + '<b>Stop-Loss setzen bei:</b> $' + formatPrice(longSlStruct) + '<br>'
      + '<b>Take-Profit 1:</b> $' + formatPrice(longTp1) + ' &nbsp;|&nbsp; <b>TP2:</b> $' + formatPrice(longTp2) + '<br>'
      + 'Bei Resistance oder MACD negativ: Teil schließen, Stop auf Einstand.';
  } else if (total >= 1 && !momFlipDown) {
    longTxt = '🟡 Long nur halten wenn bereits im Plus.<br>'
      + '<b>Stop eng:</b> $' + formatPrice(longSlTight) + '<br>'
      + '<b>Normaler Stop:</b> $' + formatPrice(longSlNorm) + '<br>'
      + 'Bei Momentum-Dreh (rote 5M + MACD negativ): sofort auf engen Stop.';
  } else {
    longTxt = '🟡 Kein neues Long.<br>'
      + 'Falls noch long: <b>Stop</b> $' + formatPrice(longSlTight) + ' (eng) oder $' + formatPrice(longSlNorm) + '.<br>'
      + 'Bei fallendem Momentum nicht nachkaufen.';
  }

  if (type === 'SHORT' && pUp) {
    shortTxt = '🟠 SHORT aktiv, aber Käufer drücken kurzfristig dagegen (' + pTxt + ').<br>'
      + '<b>Stop eng:</b> $' + formatPrice(shortSlTight) + ' &nbsp;|&nbsp; Ziel 1: $' + formatPrice(shortTp1) + '<br>'
      + 'Teilgewinn sichern, nicht nachlegen.';
  } else if (type === 'SHORT') {
    shortTxt = '🔴 SHORT-Setup aktiv.<br>'
      + '<b>Stop-Loss setzen bei:</b> $' + formatPrice(shortSlStruct) + '<br>'
      + '<b>Take-Profit 1:</b> $' + formatPrice(shortTp1) + ' &nbsp;|&nbsp; <b>TP2:</b> $' + formatPrice(shortTp2) + '<br>'
      + 'Zudecken wenn Kurs über $' + formatPrice(price + a) + ' schließt oder 5M bullish dreht.';
  } else if (momFlipDown || (netVotes <= -1 && t5.trend === 'bearish')) {
    shortTxt = '🟠 Short-Tendenz (Kurs/Momentum fällt).<br>'
      + 'Falls shorten: <b>Stop über</b> $' + formatPrice(shortSlNorm) + '<br>'
      + '<b>Ziele:</b> $' + formatPrice(shortTp1) + ' / $' + formatPrice(shortTp2) + '<br>'
      + 'Nur mit klarem Setup — nicht gegen Aufwärts-Schub.';
  } else if (type === 'LONG' || momFlipUp) {
    shortTxt = '🟢 Nicht shorten.<br>Markt tendiert aufwärts. Shorts wären gegen Momentum.';
  } else {
    shortTxt = '🟡 Kein klares Short-Setup.<br>'
      + 'Falls trotzdem short: <b>Stop</b> $' + formatPrice(shortSlTight) + ' (eng) oder $' + formatPrice(shortSlNorm) + '.';
  }

  if (momFlipDown) {
    untilTxt = '⚠️ <b>Momentum-Dreh:</b> Longs schützen JETZT — Stop $' + formatPrice(longSlTight)
      + '. Neu in 5–15 Min. Zuerst Risiko begrenzen, nicht auf altes Plus hoffen.';
  } else if (type === 'SHORT') {
    untilTxt = 'Short solange 5M bearish. Raus bei TP2 $' + formatPrice(shortTp2)
      + ', oder über $' + formatPrice(shortSlNorm) + ', oder 1H bullish. Typisch 15–90 Min.';
  } else if (type === 'LONG') {
    untilTxt = 'Long solange kein Momentum-Dreh. Stop $' + formatPrice(longSlStruct)
      + ', TP1 $' + formatPrice(longTp1) + '. Bei 3+ roten 5M-Kerzen Stop sofort auf $' + formatPrice(longSlTight) + '.';
  } else {
    untilTxt = 'Kein aktives Entry. Offene Positionen trotzdem absichern: <b>Long-Stop</b> $'
      + formatPrice(longSlNorm) + ' | <b>Short-Stop</b> $' + formatPrice(shortSlNorm) + '.';
  }

  elL.innerHTML = longTxt;
  elS.innerHTML = shortTxt;
  elU.innerHTML = untilTxt;
}

function setSignal(type, strength, reasons, explanation) {
