/* ===== Order-Flow (aggTrade), Orderbuch, VWAP ===== */
const flow = { trades: [], ob: 0 };
function flowAdd(d) {
  const now = Date.now();
  flow.trades.push({ t: now, q: +d.q, s: d.m ? -1 : 1 }); // m=true: Verkäufer war aggressiv
  const cut = now - 180000;
  while (flow.trades.length && flow.trades[0].t < cut) flow.trades.shift();
}
function flowRatio(sec) {
  const cut = Date.now() - sec * 1000;
  let d = 0, v = 0, n = 0;
  for (let i = flow.trades.length - 1; i >= 0 && flow.trades[i].t >= cut; i--) { v += flow.trades[i].q; d += flow.trades[i].s * flow.trades[i].q; n++; }
  return n >= 15 && v > 0 ? d / v : 0;
}
function calcVWAP(k) {
  if (!k || !k.length) return null;
  const d0 = Math.floor(k[k.length - 1].time / 86400000) * 86400000;
  let pv = 0, v = 0;
  k.forEach(function(x) { if (x.time >= d0) { pv += (x.high + x.low + x.close) / 3 * x.volume; v += x.volume; } });
  return v > 0 ? pv / v : null;
}

const klineCache = {};
const TF_KEYS = { '1m': '1', '3m': '3', '5m': '5', '15m': '15', '1h': '60' };
let ws = null, wsPair = null, reTimer = null, statusPaint = 0, wlPaint = 0;

async function loadKlineCaches(pair) {
  const ivs = Object.keys(TF_KEYS);
  const res = await Promise.all(ivs.map(function(iv) { return fetchBinanceKlines(pair, iv, 300); }));
  ivs.forEach(function(iv, i) { klineCache[iv] = res[i]; });
  return res.every(Boolean);
}

function closeStream() { if (ws) { ws.onclose = null; ws.close(); ws = null; } wsPair = null; }

function openStream(pair) {
  closeStream();
  flow.trades.length = 0; flow.ob = 0;
  wsPair = pair;
  const p = pair.toLowerCase();
  const streams = Object.keys(TF_KEYS).map(function(iv) { return p + '@kline_' + iv; }).concat([p + '@aggTrade', p + '@miniTicker', p + '@depth20@100ms']);
  const sock = ws = new WebSocket(wsBase() + streams.join('/'));
  sock.onopen = function() { updateDataStatus('live', 'Binance ' + (state.futures ? 'Futures' : 'Spot') + ' WebSocket'); };
  sock.onmessage = function(ev) {
    const m = JSON.parse(ev.data), d = m.data, n = m.stream;
    if (n.indexOf('@kline_') > 0) {
      const k = d.k, arr = klineCache[k.i];
      if (!arr) return;
      const c = { time: k.t, open: +k.o, high: +k.h, low: +k.l, close: +k.c, volume: +k.v };
      if (arr[arr.length - 1].time === c.time) arr[arr.length - 1] = c;
      else { arr.push(c); if (arr.length > 400) arr.shift(); }
      scheduleAnalysis();
    } else if (n.indexOf('@aggTrade') > 0) {
      state.price = +d.p;
      evaluatePendingSignals();
      flowAdd(d);
      document.getElementById('price-display').textContent = formatPrice(state.price);
      const now = Date.now();
      if (now - statusPaint > 1000) { statusPaint = now; updateDataStatus('live', 'Binance ' + (state.futures ? 'Futures' : 'Spot') + ' · Latenz ' + Math.max(0, now - d.E) + ' ms'); }
    } else if (n.indexOf('@depth') > 0) {
      const B = d.bids || d.b || [], A = d.asks || d.a || [];
      let b = 0, a = 0;
      for (let i = 0; i < Math.min(10, B.length, A.length); i++) { const w = 1 / (i + 1); b += w * +B[i][1]; a += w * +A[i][1]; }
      flow.ob = (b + a) ? (b - a) / (b + a) : 0;
    } else if (n.indexOf('@miniTicker') > 0) {
      const ch = (+d.c - +d.o) / +d.o * 100, el = document.getElementById('change-display');
      state.change24h = ch;
      el.textContent = (ch >= 0 ? '+' : '') + ch.toFixed(2) + '%';
      el.className = 'text-lg font-medium ' + (ch >= 0 ? 'text-green-400' : 'text-red-400');
    }
  };
  sock.onclose = function() {
    if (ws !== sock) return;
    updateDataStatus('offline', 'Stream getrennt – verbinde neu …');
    setTimeout(function() { if (wsPair === pair) runMultiTimeframe(pair); }, 2000);
  };
}

function scheduleAnalysis() {
  if (reTimer) return;
  reTimer = setTimeout(function() { reTimer = null; if (wsPair) runAnalysisFromCache(); }, 800);
